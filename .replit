run = "bash scripts/replit_start.sh"
modules = ["python-3.11", "nodejs-20", "web", "bash", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql", "ffmpeg"]

[packager.features]
# scripts/replit_build.sh installs the declared dependencies explicitly.
guessImports = false
enabledForHosting = false

[deployment]
run = ["bash", "scripts/replit_start.sh"]
# Autoscale's documented target. In Publishing, set Max machines to 1.
deploymentTarget = "cloudrun"
build = ["bash", "scripts/replit_build.sh"]

[[ports]]
localPort = 8000
externalPort = 80

[env]
PYTHONPATH = "."
PYTHONUNBUFFERED = "1"
