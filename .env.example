# Google Cloud / Vertex AI Settings
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Google Cloud Storage
GCS_BUCKET=your-cuecheck-media-bucket
SIGNED_URL_TTL_SECONDS=900

# Gemini Models (Vertex AI)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Optional Cloud Speech-to-Text v2
ENABLE_STT=false

# Service Account Credentials
# If running on Replit, paste the service account JSON contents here:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Or specify a path to the service account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Database (Phase 6 / Replit Postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/cuecheck

# Application Settings
APP_BASE_URL=http://localhost:8000
PORT=8000
