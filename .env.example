# Short-video live analysis through Google Cloud Vertex API-key authentication.
# Keep the real key in .env locally or Replit Secrets. Never commit it.
VERTEX_API_KEY=

# Alternative: Vertex ADC + optional Cloud Storage signed uploads.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GCS_BUCKET=
SIGNED_URL_TTL_SECONDS=900
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
ENABLE_STT=false

# Replit Postgres supplies DATABASE_URL when attached.
# DATABASE_URL=postgresql://user:password@localhost:5432/framekind
APP_BASE_URL=http://localhost:8000
PORT=8000
